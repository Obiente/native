# Copying this file is not necessary. tools/nextcloud-demo.sh init creates a
# private .env with random credentials and a private development CA.
NC_DEMO_HOST=10.0.2.2
NC_DEMO_HTTP_PORT=18080
NC_DEMO_HTTPS_PORT=8443
NC_DEMO_BIND_ADDRESS=0.0.0.0
NC_DEMO_TRUSTED_DOMAINS=localhost 127.0.0.1 10.0.2.2
NC_DEMO_DATABASE_NAME=nextcloud
NC_DEMO_DATABASE_USER=nextcloud
NC_DEMO_DATABASE_PASSWORD=replace-with-a-random-private-value
NC_DEMO_ADMIN_USER=nc-native-admin
NC_DEMO_ADMIN_PASSWORD=replace-with-a-random-private-value
NC_DEMO_TEST_USER=nc-native-e2e
NC_DEMO_TEST_PASSWORD=replace-with-a-random-private-value
