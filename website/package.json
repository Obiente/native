{
  "name": "nextcloud-native-homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "screenshots": "node scripts/generate-screenshots.mjs",
    "test": "node --test scripts/*.test.mjs",
    "predev": "npm run content",
    "dev": "vite",
    "build": "npm run test && npm run screenshots && npm run content && vite build && vite build --ssr src/entry-server.js --outDir dist-ssr && node scripts/prerender.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/vue": "2.2.1",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.40",
    "markdown-it": "14.3.0",
    "markdown-it-anchor": "9.2.1",
    "vite": "8.1.5",
    "vue": "3.5.40"
  }
}
